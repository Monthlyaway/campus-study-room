FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS build
WORKDIR /build/apps/web
COPY apps/web/package.json apps/web/pnpm-lock.yaml ./
RUN corepack enable && corepack prepare pnpm@10.34.7 --activate && pnpm install --frozen-lockfile
COPY apps/web .
ENV NODE_OPTIONS="--max-old-space-size=768"
RUN pnpm build

FROM nginx:1.30.6-alpine3.24@sha256:c59d1f8b1e0e42da75be973424cd72e23f7f8adfb54e982f4d1cd0216a5a5576
ARG RELEASE_ID=development
ARG RELEASE_COMMIT=working-tree
LABEL org.opencontainers.image.source="https://github.com/Monthlyaway/campus-study-room" \
      org.opencontainers.image.revision="${RELEASE_COMMIT}" \
      org.opencontainers.image.version="${RELEASE_ID}"
COPY --from=build /build/apps/web/dist /usr/share/nginx/html
COPY infra/compose/nginx.conf /etc/nginx/conf.d/default.conf
COPY infra/compose/proxy_params /etc/nginx/proxy_params.studyroom
COPY infra/compose/maintenance.html /usr/share/nginx/html/maintenance.html
RUN printf '{"releaseId":"%s","commit":"%s"}\n' "$RELEASE_ID" "$RELEASE_COMMIT" > /usr/share/nginx/html/version.json
EXPOSE 8080
